HANALPHA_ENV=paper
HANALPHA_CONFIG_PATH=configs/paper.yaml
HANALPHA_LEDGER_PATH=.state/ledger.sqlite3

# Required only when the corresponding capability is explicitly enabled in config.
# Use separate random values of at least 32 characters; never commit them.
HANALPHA_BROKER_WRITE_TOKEN=
HANALPHA_OPERATOR_TOKEN=
# E2 only; leave unset during E1. A verified Safety Case still does not grant Broker writes.
HANALPHA_SAFETY_CASE_VERIFICATION_KEY=
# Deployment binds a Safety Case to the exact source revision.
HANALPHA_GIT_COMMIT=

# Optional external data and LLM providers. Never commit real secrets.
# MASSIVE_API_KEY is preferred; POLYGON_API_KEY remains a compatibility alias.
MASSIVE_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=Han Alpha Research contact@example.com
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# IBKR paper: Gateway 4002, TWS 7497. Live ports must not be used with paper config.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=41
IBKR_ACCOUNT=
