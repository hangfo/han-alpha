# Intentionally inactive. Copy only after paper validation and a separate security review.
environment: live
mode: external
base_currency: USD
starting_cash: 0
universe: [SPY]
benchmarks: {market: SPY, growth: QQQ}
bar_interval_minutes: 5
lookback_bars: 120
risk:
  risk_per_trade_pct: 0.001
  max_symbol_weight: 0.03
  max_sector_weight: 0.15
  max_gross_exposure: 0.20
  max_positions: 4
  daily_loss_limit_pct: 0.005
  max_drawdown_limit_pct: 0.02
  max_order_notional: 10000
  max_quote_age_seconds: 10
  min_price: 5
  min_average_dollar_volume: 100000000
  allow_earnings_overnight: false
  allow_market_orders: false
execution:
  broker: ibkr
  auto_submit_paper: false
  require_human_approval_live: true
  slippage_bps: 8
  commission_per_share: 0.005
  minimum_commission: 1.0
  order_ttl_seconds: 20
agents:
  enabled: true
  provider: llm
  require_evidence: true
  allow_llm_to_size: false
  max_news_age_hours: 48
strategies: {}
